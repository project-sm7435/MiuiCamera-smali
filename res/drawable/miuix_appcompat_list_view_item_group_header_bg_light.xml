    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/miuix_appcompat_list_item_bg_color_light" />
            <size android:height="@dimen/crh" />
        </shape>
    </item>
    <item android:gravity="bottom" android:drawable="@drawable/miuix_appcompat_divider_line_light" android:left="@dimen/crn" />
